# Copy to /etc/kiosk/kiosk.env, then:  sudo chmod 600 /etc/kiosk/kiosk.env
# Never commit the real file.

KIOSK_DB_PATH=/var/lib/kiosk/kiosk.db
# Lock file lives in the kiosk-owned state folder, so a manual run as root can never
# leave behind a root-owned lock that blocks the nightly job.
KIOSK_SYNC_LOCK=/var/lib/kiosk/sync.lock
LOCAL_API_PORT=5003

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# KIOSK_ID is the uuid of this kiosk's row in the Supabase `kiosks` table.
# Generate both lines with deploy/make_kiosk_key.py <that uuid>
KIOSK_ID=00000000-0000-0000-0000-000000000000
KIOSK_SYNC_KEY=

# Optional: enables POST /api/local/sync/run ("sync now" button for staff). Leave empty to disable.
KIOSK_ADMIN_TOKEN=
