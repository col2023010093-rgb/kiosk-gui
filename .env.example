# Get these from your Supabase project dashboard: Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Comma-separated browser origins allowed by the Raspberry Pi sensor service.
SENSOR_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173
# Bind locally by default; set to the Pi LAN interface only when required.
SENSOR_HOST=127.0.0.1
